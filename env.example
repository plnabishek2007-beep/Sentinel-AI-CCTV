# ================= 🔐 SECURESIGHT AI ENVIRONMENT VARIABLES =================
# Copy this file to .env and fill in your values
# NEVER commit .env to Git!

# ================= 🔐 SECURITY =================
# Set a strong, unique API key (min 16 characters)
# Generate one: openssl rand -hex 16
API_KEY=your_secure_api_key_here_change_this

# ================= 📱 TELEGRAM ALERTS (OPTIONAL) =================
# Leave empty if you don't want Telegram notifications
# Get token from: https://t.me/BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Get chat ID from: https://t.me/userinfobot
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ================= 🔐 HOW TO GENERATE API KEY =================
# Option 1: Using openssl (Linux/Mac)
#   openssl rand -hex 16
#
# Option 2: Using Python
#   python3 -c "import secrets; print(secrets.token_hex(16))"
#
# Option 3: Manual (at least 32 chars)
#   YourStrongPasswordHere1234567890

# ================= ⚙️ SERVER CONFIGURATION =================
# Recommended: Keep as localhost only (127.0.0.1)
# Production: Use HTTPS and strong API keys

# ================= 📝 PRIVACY SETTINGS =================
# SAVE_UNKNOWN_FACES=False       (Never auto-save unknown faces)
# AUTO_LEARN_ENABLED=False       (Disable auto-learning)
# AUTO_DELETE_SECONDS=300        (Delete evidence after 5 minutes)
# CONSENT_REQUIRED=True          (Show consent banner)
